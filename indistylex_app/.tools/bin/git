#!/bin/sh
FLUTTER_ROOT="/home/shivam/work/tools/flutter_linux"
FRAMEWORK_REVISION="8defaa71a77c16e8547abdbfad2053ce3a6e2d5b"
ENGINE_VERSION="109150893958777c8f2215f6cfd3e89e984e8dea"

case "$1" in
  --version)
    echo "git version 2.44.0"
    exit 0
    ;;
  -C)
    shift 2
    ;;
esac

case "$1" in
  rev-parse)
    echo "$FRAMEWORK_REVISION"
    exit 0
    ;;
  ls-files)
    if [ "$2" = "bin/internal/engine.version" ]; then
      echo "bin/internal/engine.version"
    fi
    exit 0
    ;;
  remote)
    exit 1
    ;;
  merge-base)
    echo "$ENGINE_VERSION"
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
